    "adventure": {
      "title": "Choose Your Own Adventure",
      "lede": "Tick the ones you and Peter do.",
      "sections": [
        {
          "type": "checklist",
          "id": "campus",
          "header": "Simple on-campus ideas",
          "items": [
            {
              "id": "longway",
              "title": "Take the Long Way",
              "subtitle": "Walk one of the Woodlands trails and explore the wilderness. Let your son choose the route and pace.",
              "quote": "What's something about your world that you wish I understood better?"
            },
            {
              "id": "photos",
              "title": "The Five-Photo Quest",
              "subtitle": "Find and photograph five things that represent courage, strength, beauty, brotherhood, and hope. Compare your choices afterward. Use your phone as a camera, then put it away.",
              "quote": "Which picture says the most about who you want to become?"
            },
            {
              "id": "teach",
              "title": "Teach Me Something",
              "subtitle": "Each gets 20 minutes to teach the other a skill: a knot, drawing trick, juggling, a ball skill, or something else he enjoys. Finish with a cooperative challenge.",
              "quote": "What's something you'd enjoy getting better at together?"
            },
            {
              "id": "letter",
              "title": "A Letter for the Road Ahead",
              "subtitle": "Find a quiet spot. Dad writes three specific things he sees growing in his son; the son writes something he appreciates and something he'd like to do together. Read them aloud if comfortable, then choose one next step.",
              "quote": "What's one thing we want to keep doing when we get home?"
            }
          ]
        },
        {
          "type": "checklist",
          "id": "outings",
          "header": "Nearby outings",
          "items": [
            {
              "id": "shakes",
              "title": "Two Shakes, Two Stories",
              "subtitle": "Visit Soda Fountain Café or Chick-fil-A. Your son chooses the treat; Dad tells a funny story and a hard story from when he was his son's age.",
              "quote": "What surprised you about what I was like at your age?"
            },
            {
              "id": "river",
              "title": "Walk Beside the River",
              "subtitle": "Explore the Helen-to-Hardman Heritage Trail. It's a free, paved riverside trail, one mile each way. Start at the Hardman end and turn around early if needed."
            },
            {
              "id": "creek",
              "title": "Creekside Snack and Slow Down",
              "subtitle": "Take a snack to Smithgall Woods. Walk the short Visitor Center Loop beside Dukes Creek, then sit together. Spend five minutes listening before talking. Parking is currently $10 per vehicle."
            },
            {
              "id": "mill",
              "title": "Figure Out How It Works",
              "subtitle": "Visit Nora Mill Granary, a working historic gristmill. Discover how water becomes useful work. Pick a mix to cook together at home."
            }
          ],
          "footer": "Checked items are saved on this phone."
        }
      ]
    },
